<%- include('../../partials/header', { title: `Quản Trị Chi Tiết: ${dish.name} - RESTORAN` }) %>
<%- include('../../partials/navbar') %>

<!-- Page Hero Section -->
<section class="page-hero">
  <div class="page-hero__bg">
    <img src="/assets/img/menu-bg.svg" alt="<%= dish.name %>">
  </div>
  <div class="page-hero__overlay"></div>
  <div class="container page-hero__content">
    <h1 class="page-hero__title"><%= dish.name %></h1>
    <p class="page-hero__breadcrumb">
      <a href="/admin/dishes">Cổng Quản Trị</a> &nbsp;/&nbsp; Chi Tiết Món Ăn #<%= dish.id %>
    </p>
  </div>
</section>

<!-- Detail Section với quyền Quản Trị (Sửa & Xóa) -->
<section class="section">
  <div class="container" style="max-width: 1000px;">
    <div class="detail-card">
      <div class="detail-layout">
        <% 
          const imgIndex = ((dish.id - 1) % 6) + 1;
          const fallbackImg = '/assets/img/food-' + imgIndex + '.svg';
          const displayImg = dish.imageUrl || fallbackImg;
        %>
        <div class="detail-image-box">
          <img src="<%= displayImg %>" alt="<%= dish.name %>" onerror="this.onerror=null; this.src='<%= fallbackImg %>';">
        </div>

        <div class="detail-info">
          <div class="detail-badges">
            <% if (dish.category) { %>
              <span class="menu-item__tag"><%= dish.category %></span>
            <% } %>
            <span class="menu-item__tag <%= dish.available ? 'menu-item__tag--available' : 'menu-item__tag--unavailable' %>">
              <%= dish.available ? 'Đang phục vụ' : 'Tạm hết' %>
            </span>
            <span class="menu-item__tag menu-item__tag--unit">Mã món: #<%= dish.id %></span>
          </div>

          <h2 class="detail-title"><%= dish.name %></h2>
          <div class="detail-price-text"><%= dish.price.toLocaleString('vi-VN') %> VNĐ</div>

          <p class="detail-desc">
            <%= dish.description ? dish.description : 'Món ăn đặc sản mang đậm phong vị ẩm thực truyền thống, được lưu trữ trong cơ sở dữ liệu Supabase.' %>
          </p>

          <div class="detail-meta-list">
            <div>
              <div class="meta-label">Ngày Thêm / Cập Nhật</div>
              <div class="meta-value"><%= new Date(dish.createdAt).toLocaleDateString('vi-VN', { year: 'numeric', month: '2-digit', day: '2-digit' }) %></div>
            </div>
            <div>
              <div class="meta-label">Phân Loại Món</div>
              <div class="meta-value"><%= dish.category ? dish.category : 'Món chung' %></div>
            </div>
            <div>
              <div class="meta-label">Tình Trạng Bếp</div>
              <div class="meta-value"><%= dish.available ? 'Sẵn sàng phục vụ' : 'Tạm dừng nhận order' %></div>
            </div>
          </div>

          <!-- Các nút thao tác trong chế độ Quản Trị -->
          <div class="detail-actions" style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin-top: 10px;">
            <a href="/admin/dishes" class="btn btn--primary">← Về Danh Sách Quản Trị</a>
            <a href="/admin/dishes/<%= dish.id %>/edit" class="btn btn--outline" style="color: var(--charcoal);">Sửa Món Ăn</a>
            <a href="/admin/dishes/<%= dish.id %>/delete" class="btn btn--ghost">Xóa Món Ăn</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>
