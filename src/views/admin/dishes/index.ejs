<%- include('../../partials/header', { title: 'Quản Trị Món Ăn - RESTORAN' }) %>
<%- include('../../partials/navbar') %>

<section class="section" style="padding-top: 120px;">
  <div class="container">
    <div class="admin-header">
      <div>
        <h1 class="admin-header__title">Quản Trị Món Ăn</h1>
        <p class="admin-header__subtitle">Danh sách toàn bộ các món ăn trong cơ sở dữ liệu Supabase.</p>
      </div>
      <div>
        <a href="/admin/dishes/new" class="btn btn--primary">+ Thêm Món Ăn Mới</a>
      </div>
    </div>

    <!-- Thanh Tìm Kiếm + Bộ Lọc Đa Tiêu Chí (SSR Form GET chuẩn, không AJAX) -->
    <div class="admin-filter-card">
      <form action="/admin/dishes" method="GET" class="admin-filter-form">
        <!-- 1. Ô tìm kiếm từ khóa -->
        <div class="admin-filter-field admin-filter-field--search">
          <label class="admin-filter-label" for="filter-q">Tìm kiếm từ khóa</label>
          <input
            type="text"
            id="filter-q"
            name="q"
            value="<%= typeof filters !== 'undefined' && filters.q ? filters.q : '' %>"
            placeholder="Tìm theo tên món hoặc mô tả..."
            class="admin-filter-input"
          >
        </div>

        <!-- 2. Lọc theo Phân loại -->
        <div class="admin-filter-field">
          <label class="admin-filter-label" for="filter-category">Phân loại món</label>
          <select id="filter-category" name="category" class="admin-filter-select">
            <option value="">-- Tất cả phân loại --</option>
            <% if (typeof categories !== 'undefined') { %>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat %>" <%= typeof filters !== 'undefined' && filters.category === cat ? 'selected' : '' %>>
                  <%= cat %>
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- 3. Lọc theo Trạng thái -->
        <div class="admin-filter-field">
          <label class="admin-filter-label" for="filter-status">Trạng thái bếp</label>
          <select id="filter-status" name="status" class="admin-filter-select">
            <option value="">-- Tất cả trạng thái --</option>
            <option value="available" <%= typeof filters !== 'undefined' && filters.status === 'available' ? 'selected' : '' %>>Đang phục vụ</option>
            <option value="unavailable" <%= typeof filters !== 'undefined' && filters.status === 'unavailable' ? 'selected' : '' %>>Tạm hết món</option>
          </select>
        </div>

        <!-- 4. Sắp xếp kết quả -->
        <div class="admin-filter-field">
          <label class="admin-filter-label" for="filter-sort">Sắp xếp theo</label>
          <select id="filter-sort" name="sort" class="admin-filter-select">
            <option value="" <%= typeof filters !== 'undefined' && !filters.sort ? 'selected' : '' %>>Mặc định (ID tăng dần)</option>
            <option value="price_asc" <%= typeof filters !== 'undefined' && filters.sort === 'price_asc' ? 'selected' : '' %>>Giá: Thấp đến Cao</option>
            <option value="price_desc" <%= typeof filters !== 'undefined' && filters.sort === 'price_desc' ? 'selected' : '' %>>Giá: Cao đến Thấp</option>
            <option value="name" <%= typeof filters !== 'undefined' && filters.sort === 'name' ? 'selected' : '' %>>Tên: A - Z</option>
            <option value="newest" <%= typeof filters !== 'undefined' && filters.sort === 'newest' ? 'selected' : '' %>>Mới cập nhật nhất</option>
          </select>
        </div>

        <!-- Nút Thực thi & Xóa lọc -->
        <div class="admin-filter-buttons">
          <button type="submit" class="admin-filter-btn btn--primary">🔍 Lọc Dữ Liệu</button>
          <% const hasFilter = typeof filters !== 'undefined' && (filters.q || filters.category || filters.status || filters.sort); %>
          <% if (hasFilter) { %>
            <a href="/admin/dishes" class="admin-filter-btn btn--ghost" title="Xóa tất cả điều kiện lọc">✕ Xóa Lọc</a>
          <% } %>
        </div>
      </form>

      <!-- Dòng trạng thái tổng kết kết quả lọc -->
      <div class="admin-filter-summary">
        <div>
          Hiển thị <strong><%= dishes.length %></strong> món ăn (trên tổng số <strong><%= typeof totalCount !== 'undefined' ? totalCount : dishes.length %></strong> món trong hệ thống)
        </div>
        <% if (hasFilter) { %>
          <div style="font-size: 0.82rem; color: var(--gold-dark, #b45309);">
            * Đang áp dụng bộ lọc tùy chỉnh
          </div>
        <% } %>
      </div>
    </div>

    <!-- Bảng danh sách món ăn -->
    <div class="admin-table-card">
      <div style="overflow-x: auto;">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 70px;">ID</th>
              <th style="width: 80px; text-align: center;">Hình Ảnh</th>
              <th>Tên Món Ăn & Mô Tả</th>
              <th>Phân Loại</th>
              <th>Đơn Giá</th>
              <th>Trạng Thái</th>
              <th style="width: 220px; text-align: center;">Hành Động</th>
            </tr>
          </thead>
          <tbody>
            <% if (dishes.length === 0) { %>
              <tr>
                <td colspan="7" style="text-align: center; padding: 50px 20px;">
                  <div style="font-size: 1.1rem; color: var(--text-dark); margin-bottom: 8px;">Không tìm thấy món ăn nào phù hợp với bộ lọc.</div>
                  <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 16px;">Vui lòng thử điều chỉnh lại từ khóa hoặc xóa bớt tiêu chí lọc.</p>
                  <a href="/admin/dishes" class="btn btn--outline" style="color: var(--charcoal); font-size: 0.8rem;">Xóa Bộ Lọc</a>
                </td>
              </tr>
            <% } else { %>
              <% dishes.forEach(function(dish) { 
                   const fallbackImg = '/assets/img/food-' + (((dish.id - 1) % 6) + 1) + '.svg';
                   const displayImg = dish.imageUrl || fallbackImg;
              %>
                <tr>
                  <td><strong>#<%= dish.id %></strong></td>
                  <td style="text-align: center;">
                    <a href="/admin/dishes/<%= dish.id %>">
                      <img 
                        src="<%= displayImg %>" 
                        alt="<%= dish.name %>" 
                        class="dish-thumb"
                        onerror="this.onerror=null; this.src='<%= fallbackImg %>';"
                      >
                    </a>
                  </td>
                  <td>
                    <a href="/admin/dishes/<%= dish.id %>" style="color: var(--charcoal); font-weight: 700; text-decoration: none; font-size: 1.05rem;">
                      <%= dish.name %>
                    </a>
                    <% if (dish.description) { %>
                      <div style="font-size: 0.84rem; color: var(--text-muted); margin-top: 4px; line-height: 1.4;">
                        <%= dish.description.length > 70 ? dish.description.substring(0, 70) + '...' : dish.description %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span class="menu-item__tag"><%= dish.category || 'Món chung' %></span>
                  </td>
                  <td><strong style="color: var(--burgundy); font-family: 'Cormorant Garamond', serif; font-size: 1.25rem;"><%= dish.price.toLocaleString('vi-VN') %> đ</strong></td>
                  <td>
                    <span class="menu-item__tag <%= dish.available ? 'menu-item__tag--available' : 'menu-item__tag--unavailable' %>">
                      <%= dish.available ? 'Đang phục vụ' : 'Tạm hết' %>
                    </span>
                  </td>
                  <td class="action-cell">
                    <a href="/admin/dishes/<%= dish.id %>" class="btn-xs btn-xs-view">Xem</a>
                    <a href="/admin/dishes/<%= dish.id %>/edit" class="btn-xs btn-xs-edit">Sửa</a>
                    <a href="/admin/dishes/<%= dish.id %>/delete" class="btn-xs btn-xs-delete">Xóa</a>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>
