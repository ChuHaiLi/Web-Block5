<%- include('../../partials/header', { title: `Chỉnh Sửa: ${dish.name} - RESTORAN` }) %>
<%- include('../../partials/navbar') %>

<section class="section" style="padding-top: 120px;">
  <div class="container">
    <div class="form-card">
      <div class="form-header">
        <h1 class="form-title">Chỉnh Sửa Món Ăn</h1>
        <p class="form-subtitle">Cập nhật thông tin món ăn ID #<%= dish.id %> qua phương thức PATCH (Method Override).</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger" role="alert">
          <div class="alert-content">
            <strong>Lỗi xác thực dữ liệu (HTTP 400 Bad Request):</strong>
            <p><%= error %></p>
          </div>
        </div>
      <% } %>

      <!-- Form gửi POST với ?_method=PATCH qua method-override -->
      <form action="/admin/dishes/<%= dish.id %>?_method=PATCH" method="POST" class="standard-form">
        <div class="form-group">
          <label for="name" class="form-label required">Tên Món Ăn:</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            class="form-control" 
            value="<%= dish.name || '' %>"
            required
          >
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="price" class="form-label required">Đơn Giá (VNĐ):</label>
            <input 
              type="number" 
              id="price" 
              name="price" 
              class="form-control" 
              min="0" 
              value="<%= dish.price !== undefined ? dish.price : '' %>"
              required
            >
          </div>

          <div class="form-group">
            <label for="category" class="form-label">Phân Loại Món:</label>
            <input 
              type="text" 
              id="category" 
              name="category" 
              class="form-control" 
              value="<%= dish.category || '' %>"
            >
          </div>
        </div>

        <!-- Chọn Đầu Bếp Phụ Trách -->
        <div class="form-group">
          <label for="chefId" class="form-label required">Đầu Bếp Phụ Trách (Chef):</label>
          <select id="chefId" name="chefId" class="form-control" required>
            <option value="">-- Chọn đầu bếp phụ trách món ăn --</option>
            <% if (typeof chefs !== 'undefined' && chefs.length > 0) { %>
              <% chefs.forEach(function(chef) { %>
                <option value="<%= chef.id %>" <%= (typeof dish !== 'undefined' && Number(dish.chefId) === chef.id) ? 'selected' : '' %>>
                  👨‍🍳 <%= chef.name %> — <%= chef.role || 'Đầu bếp' %> (<%= chef.specialty || 'Ẩm thực' %>)
                </option>
              <% }); %>
            <% } %>
          </select>
          <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 4px; display: block;">Mỗi món ăn bắt buộc phải có một đầu bếp đảm nhiệm chế biến.</small>
        </div>

        <!-- Chọn Danh Sách Nguyên Liệu -->
        <div class="form-group">
          <label class="form-label required">Danh Sách Nguyên Liệu (Chọn ít nhất 1 loại):</label>
          <% 
            const selectedIngIds = (typeof dish !== 'undefined' && dish.ingredients) 
              ? dish.ingredients.map(i => Number(i.id || i)) 
              : []; 
          %>
          <div class="ingredients-checkbox-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; max-height: 240px; overflow-y: auto; padding: 12px; background: var(--cream); border: 2px solid #E7E5E4; border-radius: var(--radius-sm);">
            <% if (typeof ingredients !== 'undefined' && ingredients.length > 0) { %>
              <% ingredients.forEach(function(ing) { 
                   const isChecked = selectedIngIds.includes(ing.id);
              %>
                <label style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; cursor: pointer; padding: 8px 10px; background: var(--white); border-radius: 4px; border: 1px solid <%= isChecked ? 'var(--burgundy)' : '#E7E5E4' %>; text-transform: none; letter-spacing: normal; font-weight: 400; margin-bottom: 0;">
                  <input 
                    type="checkbox" 
                    name="ingredientIds" 
                    value="<%= ing.id %>" 
                    <%= isChecked ? 'checked' : '' %>
                    style="width: 16px; height: 16px; accent-color: var(--burgundy); margin: 0; cursor: pointer;"
                  >
                  <span style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    <strong><%= ing.name %></strong>
                    <small style="color: var(--text-muted); display: block; font-size: 0.75rem;"><%= (ing.quantity || 0).toLocaleString('vi-VN') %> <%= ing.unit %></small>
                  </span>
                </label>
              <% }); %>
            <% } else { %>
              <p style="color: var(--text-muted); font-size: 0.85rem; padding: 8px;">Chưa có nguyên liệu nào trong hệ thống.</p>
            <% } %>
          </div>
          <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 4px; display: block;">Tích chọn các nguyên liệu cấu thành nên món ăn này.</small>
        </div>

        <div class="form-group">
          <label for="imageUrl" class="form-label">Đường Dẫn Hình Ảnh (URL hoặc /assets/img/dishes/...):</label>
          <div style="display: flex; gap: 14px; align-items: center;">
            <input 
              type="text" 
              id="imageUrl" 
              name="imageUrl" 
              class="form-control" 
              value="<%= dish.imageUrl || '' %>"
              placeholder="Ví dụ: /assets/img/dishes/pho-bo.jpg"
              style="flex: 1;"
            >
            <% if (dish.imageUrl) { %>
              <img 
                src="<%= dish.imageUrl %>" 
                alt="Preview" 
                class="dish-thumb" 
                style="width: 44px; height: 44px; flex-shrink: 0;"
              >
            <% } %>
          </div>
        </div>

        <div class="form-group">
          <label for="description" class="form-label">Mô Tả Hương Vị:</label>
          <textarea 
            id="description" 
            name="description" 
            class="form-control" 
            rows="4"
          ><%= dish.description || '' %></textarea>
        </div>

        <div class="form-group">
          <label class="custom-checkbox">
            <input 
              type="checkbox" 
              name="available" 
              <%= (dish.available === true || dish.available === 'on' || dish.available === 'true') ? 'checked' : '' %>
            >
            <span>Món ăn đang sẵn sàng phục vụ thực khách (Available)</span>
          </label>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Lưu Thay Đổi</button>
          <a href="/admin/dishes" class="btn btn--ghost">Hủy Bỏ</a>
        </div>
      </form>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>
