<%- include('../../partials/header', { title: `Xác Nhận Xóa: ${chef.name} - RESTORAN` }) %>
<%- include('../../partials/navbar') %>

<section class="section" style="padding-top: 120px;">
  <div class="container">
    <div class="confirm-card">
      <h1 class="confirm-title">Xác Nhận Xóa Đầu Bếp</h1>
      <p class="confirm-subtitle">
        Bạn có chắc chắn muốn xóa hồ sơ đầu bếp này khỏi hệ thống cơ sở dữ liệu Supabase không?
      </p>

      <div class="confirm-target-box">
        <div class="target-title"><%= chef.name %></div>
        <div class="target-meta">
          <span>Mã đầu bếp: #<%= chef.id %></span>
          <span>•</span>
          <span>Sở trường: <%= chef.specialty %></span>
        </div>
      </div>

      <div class="confirm-warning-note">
        Lưu ý: Hành động này sẽ xóa dữ liệu vĩnh viễn và không thể hoàn tác sau khi đã thực hiện.
      </div>

      <form action="/admin/chefs/<%= chef.id %>?_method=DELETE" method="POST" class="confirm-actions">
        <button type="submit" class="btn btn--primary" style="background: var(--burgundy); color: #fff; width: 100%;">
          Xác Nhận Xóa Vĩnh Viễn
        </button>
        <a href="/admin/chefs" class="btn btn--ghost" style="width: 100%; text-align: center;">
          Hủy Bỏ và Quay Lại
        </a>
      </form>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>
