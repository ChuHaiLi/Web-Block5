<%- include('../../partials/header', { title: 'Quản Trị Đầu Bếp - RESTORAN' }) %>
<%- include('../../partials/navbar') %>

<section class="section" style="padding-top: 120px;">
  <div class="container">
    <div class="admin-header">
      <div>
        <h1 class="admin-header__title">Quản Trị Đội Ngũ Đầu Bếp</h1>
        <p class="admin-header__subtitle">Danh sách các bếp trưởng và chuyên gia ẩm thực của nhà hàng.</p>
      </div>
      <div>
        <a href="/admin/chefs/new" class="btn btn--primary">+ Thêm Đầu Bếp</a>
      </div>
    </div>

    <!-- Thanh Tìm Kiếm Đầu Bếp -->
    <div class="admin-filter-card">
      <form action="/admin/chefs" method="GET" class="admin-filter-form">
        <div class="admin-filter-field admin-filter-field--search">
          <label class="admin-filter-label" for="filter-q">Tìm kiếm đầu bếp</label>
          <input
            type="text"
            id="filter-q"
            name="q"
            value="<%= typeof q !== 'undefined' ? q : '' %>"
            placeholder="Tìm theo tên đầu bếp hoặc chuyên môn..."
            class="admin-filter-input"
          >
        </div>
        <div class="admin-filter-buttons">
          <button type="submit" class="admin-filter-btn btn--primary">🔍 Tìm Kiếm</button>
          <% if (typeof q !== 'undefined' && q) { %>
            <a href="/admin/chefs" class="admin-filter-btn btn--ghost">✕ Xóa Tìm Kiếm</a>
          <% } %>
        </div>
      </form>
      <div class="admin-filter-summary">
        <div>
          Hiển thị <strong><%= chefs.length %></strong> đầu bếp (trên tổng số <strong><%= typeof totalCount !== 'undefined' ? totalCount : chefs.length %></strong> đầu bếp)
        </div>
        <% if (typeof q !== 'undefined' && q) { %>
          <div style="font-size: 0.82rem; color: var(--gold-dark, #b45309);">
            * Kết quả tìm kiếm cho từ khóa: "<%= q %>"
          </div>
        <% } %>
      </div>
    </div>

    <div class="admin-table-card">
      <div style="overflow-x: auto;">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 70px;">ID</th>
              <th>Họ và Tên Đầu Bếp</th>
              <th>Sở Trường / Chuyên Môn</th>
              <th>Ngày Tham Gia</th>
              <th style="width: 180px; text-align: center;">Hành Động</th>
            </tr>
          </thead>
          <tbody>
            <% if (chefs.length === 0) { %>
              <tr>
                <td colspan="5" style="text-align: center; padding: 40px;">
                  Chưa có thông tin đầu bếp nào phù hợp với tìm kiếm.
                  <% if (typeof q !== 'undefined' && q) { %>
                    <div style="margin-top: 12px;"><a href="/admin/chefs" class="btn btn--ghost">Xem tất cả đầu bếp</a></div>
                  <% } %>
                </td>
              </tr>
            <% } else { %>
              <% chefs.forEach(function(chef) { %>
                <tr>
                  <td><strong>#<%= chef.id %></strong></td>
                  <td><strong style="color: var(--charcoal); font-size: 1.05rem;"><%= chef.name %></strong></td>
                  <td><%= chef.specialty %></td>
                  <td><%= new Date(chef.createdAt).toLocaleDateString('vi-VN') %></td>
                  <td class="action-cell">
                    <a href="/admin/chefs/<%= chef.id %>/edit" class="btn-xs btn-xs-edit">Sửa</a>
                    <a href="/admin/chefs/<%= chef.id %>/delete" class="btn-xs btn-xs-delete">Xóa</a>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>
