<%- include('../../partials/header', { title: `Xác Nhận Xóa: ${ingredient.name} - RESTORAN` }) %>
<%- include('../../partials/navbar') %>

<section class="section" style="padding-top: 120px;">
  <div class="container">
    <div class="confirm-card">
      <h1 class="confirm-title">Xác Nhận Xóa Nguyên Liệu</h1>
      <p class="confirm-subtitle">
        Bạn có chắc chắn muốn xóa nguyên liệu này khỏi cơ sở dữ liệu Supabase không?
      </p>

      <div class="confirm-target-box">
        <div class="target-title"><%= ingredient.name %></div>
        <div class="target-meta">
          <span>Mã nguyên liệu: #<%= ingredient.id %></span>
          <span>•</span>
          <span>Đơn vị tính: <%= ingredient.unit %></span>
        </div>
      </div>

      <div class="confirm-warning-note">
        Lưu ý: Thao tác này sẽ xóa vĩnh viễn dữ liệu và không thể hoàn tác sau khi đã thực hiện.
      </div>

      <form action="/admin/ingredients/<%= ingredient.id %>?_method=DELETE" method="POST" class="confirm-actions">
        <button type="submit" class="btn btn--primary" style="background: var(--burgundy); color: #fff; width: 100%;">
          Xác Nhận Xóa Vĩnh Viễn
        </button>
        <a href="/admin/ingredients" class="btn btn--ghost" style="width: 100%; text-align: center;">
          Hủy Bỏ và Quay Lại
        </a>
      </form>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>
